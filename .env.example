# --- Stockage (obligatoire sur Vercel) ---------------------------------------
# Créé automatiquement en ajoutant « Upstash for Redis » depuis l'onglet Storage
# du projet Vercel. En local, si ces variables sont absentes, l'application
# écrit dans le dossier data/ (fichiers JSON).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Noms alternatifs injectés par certaines intégrations Vercel (équivalents) :
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Notifications push (facultatif) -----------------------------------------
# Générer une paire de clés avec : npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@exemple.fr

# --- Cron Vercel (facultatif) -------------------------------------------------
# Protège /api/cron/rotate. Vercel envoie ce secret dans l'en-tête Authorization.
CRON_SECRET=
